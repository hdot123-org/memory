<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.factory.webhook-hygiene</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/busiji/.factory/webhook/scripts/webhook-hygiene.sh</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>/Users/busiji</string>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin:/opt/homebrew/bin</string>
        <key>DRY_RUN</key>
        <string>0</string>
        <key>POSTHOG_API_KEY</key>
        <string>${POSTHOG_API_KEY}</string>
    </dict>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>4</integer>
        <key>Minute</key>
        <integer>30</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/busiji/.factory/webhook/logs/webhook-hygiene-stdout.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/busiji/.factory/webhook/logs/webhook-hygiene-stderr.log</string>

    <key>WorkingDirectory</key>
    <string>/Users/busiji/.factory/webhook</string>
</dict>
</plist>
